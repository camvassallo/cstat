DATABASE_URL=postgres://localhost:5432/cstat
NATSTAT_API_KEY=xxxx-xxxxxx
# NatStat per-hour rate budget (standard tier = 500). Set higher if your account allows.
# NATSTAT_MAX_PER_HOUR=500
BIND_ADDR=0.0.0.0:8080
RUST_LOG=cstat_api=info,cstat_ingest=info

# Optional. Used only by scripts/sync_to_prod.sh to push local data → Railway.
# PROD_DATABASE_URL=postgresql://user:pass@host:port/dbname
