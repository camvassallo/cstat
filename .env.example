DATABASE_URL=postgres://localhost:5432/cstat
NATSTAT_API_KEY=xxxx-xxxxxx
# NatStat per-hour rate budget (standard tier = 500). Set higher if your account allows.
# NATSTAT_MAX_PER_HOUR=500
BIND_ADDR=0.0.0.0:8080
RUST_LOG=cstat_api=info,cstat_ingest=info
# Postgres connection pool size (default 25). The API fans out concurrent
# queries per request (team_detail projects every schedule game in parallel);
# lower this if your managed Postgres plan caps connections below ~100.
# DATABASE_MAX_CONNECTIONS=25
# API serving guards (see crates/cstat-api/src/guards.rs):
#   REQUEST_TIMEOUT_SECS  — abandon a request with 408 after this long (default 30)
#   MAX_INFLIGHT_REQUESTS — shed with 503 past this many concurrent requests (default 256)
# REQUEST_TIMEOUT_SECS=30
# MAX_INFLIGHT_REQUESTS=256

# Optional. Used only by scripts/sync_to_prod.sh to push local data → Railway.
# PROD_DATABASE_URL=postgresql://user:pass@host:port/dbname

# Optional — Slack notifications. A Slack incoming webhook is locked to ONE
# channel, so each channel gets its own URL in its own env var (see
# crates/cstat-ingest/src/notify.rs::SlackChannel). Unset = no posts (the
# would-be message is logged). Set each on the service that produces it.
#
# SLACK_WEBHOOK_CRON — #cron-job-alerts. `cstat-ingest nightly` posts one message
#   per run: a success heartbeat (clean run), a degraded warning (a best-effort
#   feed failed or rate-budget headroom got low), or a critical alert (an
#   aborted run). Set on the Railway cron service. (Legacy name
#   INGEST_ALERT_WEBHOOK is still honoured as a fallback.)
# SLACK_WEBHOOK_CRON=https://hooks.slack.com/services/XXX/YYY/ZZZ
#
# Future channels (add the env var + a SlackChannel variant when the producer
# exists; the channels don't have to be created until then):
# SLACK_WEBHOOK_ERRORS_API=   # #errors-api — cstat-api runtime errors
# SLACK_WEBHOOK_ERRORS_WEB=   # #errors-web — frontend error reports
#
# CF_ZONE_ID + CF_CACHE_PURGE_TOKEN — Cloudflare zone id + a scoped API token
#   with Cache Purge permission. When BOTH are set, the nightly job purges the
#   edge cache after a successful compute so fresh data lands instantly instead
#   of within the 5-min Cache-Control TTL. Unset = no purge (TTL still applies).
# CF_ZONE_ID=
# CF_CACHE_PURGE_TOKEN=
